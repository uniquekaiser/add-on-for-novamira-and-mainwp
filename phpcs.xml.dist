<?xml version="1.0"?>
<ruleset name="Add-on for Novamira and MainWP">
    <description>WordPress and PHP 7.4 compatibility checks.</description>
    <file>mainwp-novamira-addon.php</file>
    <file>includes</file>
    <exclude-pattern>tests/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <config name="testVersion" value="7.4-"/>
    <rule ref="WordPress-Core">
        <exclude name="Generic.Files.LineLength.TooLong"/>
    </rule>
    <rule ref="PHPCompatibilityWP"/>
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <exclude-pattern>includes/provider-config-registry.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.I18n">
        <exclude-pattern>includes/provider-config-registry.php</exclude-pattern>
    </rule>
</ruleset>
